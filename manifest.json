{
  "id": "/login/",
  "name": "VBO Organiser",
  "short_name": "Organiser",
  "description": "Organise notes, schedules, goals and business tools in one place.",
  "start_url": "/login/",
  "scope": "/login/",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "display": "standalone",
  "orientation": "any",
  "categories": ["productivity", "business"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://vbo.co.in/login/manifest.webmanifest",
      "id": "https://vbo.co.in/login/"
    }
  ],
  "background_color": "#f1f5f9",
  "theme_color": "#0b3768",
  "icons": [
    {
      "src": "/login/assets/vbo-notification-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/login/assets/vbo-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/login/assets/vbo-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
